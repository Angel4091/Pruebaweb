# Copia este archivo como apps/frontend/.env solo si necesitas cambiar algo.
# Las variables VITE_ quedan dentro del build y cualquiera puede verlas: nunca pongas secretos aquí.

# Desarrollo: a dónde envía Vite las peticiones /api (por defecto http://localhost:3000).
VITE_API_TARGET=

# Producción con el frontend y la API en dominios distintos (por ejemplo, Netlify y Render):
# URL completa de la API, por ejemplo https://origenes-api.onrender.com/api
# Con NginX (deploy/nginx.conf) déjala vacía: el frontend usa /api en su mismo dominio.
VITE_API_URL=
