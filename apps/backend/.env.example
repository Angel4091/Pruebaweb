# Copia este archivo como apps/backend/.env y completa los valores vacíos.
# El archivo .env nunca se sube al repositorio.

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# PostgreSQL (docker-compose.yml usa estos mismos valores)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=origenes
DB_NAME_TEST=origenes_test
DB_USER=origenes
# Contraseña de tu base local: escribe cualquiera antes del primer `npm run db:up`.
DB_PASSWORD=
# true solo si la base está en la nube y exige conexión cifrada.
DB_SSL=false
# Ruta al certificado de la base en la nube (opcional).
DB_SSL_CA=

# ------------------------------------------------------------
# Datos de demostración
# ------------------------------------------------------------
# Contraseña de los usuarios de prueba que crea `npm run db:seed`.
# Mínimo 12 caracteres; usa una distinta en cada ambiente.
SEED_PASSWORD=
